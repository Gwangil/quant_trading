# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL - Main Database
# 주요 데이터베이스: 전략, 포트폴리오, 주문, 백테스트 결과 등 핵심 데이터 저장
POSTGRES_DB=quant_trading
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=your_secure_password_here  # 강력한 비밀번호로 변경 필수

# TimescaleDB - Time Series Database
# 시계열 데이터베이스: OHLCV 등 시장 데이터를 효율적으로 저장/조회
# TimescaleDB는 PostgreSQL 확장으로 시계열 데이터에 최적화됨
TIMESCALE_DB=market_data
TIMESCALE_USER=timescale_user
TIMESCALE_PASSWORD=your_secure_password_here  # 강력한 비밀번호로 변경 필수

# ============================================================================
# CACHE & MESSAGE QUEUE CONFIGURATION
# ============================================================================

# Redis Configuration
# 캐시 서버: 실시간 데이터 캐싱, 세션 관리, 임시 데이터 저장
# 데이터 수집 속도 향상 및 API 응답 시간 단축
REDIS_URL=redis://redis:6379

# RabbitMQ Configuration
# 메시지 큐: 마이크로서비스 간 비동기 통신
# 신호 전파, 주문 처리, 이벤트 알림 등에 사용
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_secure_password_here  # 강력한 비밀번호로 변경 필수
RABBITMQ_URL=amqp://admin:your_secure_password_here@rabbitmq:5672/

# ============================================================================
# MARKET DATA API KEYS (Optional but Highly Recommended)
# ============================================================================

# Alpha Vantage API Key (Optional)
# 효과: 백업 데이터 소스 제공, yfinance 장애 시 자동 전환
# 무료 티어: 분당 5회, 일 500회 제한
# 획득: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Polygon.io API Key (Optional)
# 효과: 고품질 실시간/과거 데이터, 더 많은 지표 제공
# 무료 티어: 월 무제한 과거 데이터, 실시간은 제한
# 획득: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=

# IEX Cloud API Key (Optional)
# 효과: 추가 데이터 소스, 기업 재무제표 데이터 접근
# 무료 티어: 월 50,000 메시지
# 획득: https://iexcloud.io/console/tokens
IEX_CLOUD_API_KEY=

# ============================================================================
# BROKER CONFIGURATION (Optional - For Live Trading)
# ============================================================================

# Broker API Configuration
# 실제 거래를 위한 브로커 API 설정
# 효과: Paper Trading에서 실거래로 전환 가능
# 지원 브로커: Alpaca, Interactive Brokers, TD Ameritrade 등
BROKER_API_KEY=                    # 브로커에서 발급받은 API 키
BROKER_API_SECRET=                  # 브로커에서 발급받은 API 시크릿
BROKER_ACCOUNT_ID=                  # 거래 계좌 번호
BROKER_PAPER_TRADING=true           # true: 모의거래, false: 실거래

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment Configuration
# development: 개발 모드 (디버깅 활성화, 상세 로그)
# staging: 스테이징 환경 (실제 환경과 유사한 테스트)
# production: 운영 환경 (최적화, 보안 강화)
ENVIRONMENT=development

# Logging Level
# DEBUG: 모든 상세 정보 (개발 시)
# INFO: 일반 정보 (기본값)
# WARNING: 경고 메시지
# ERROR: 오류만 기록
LOG_LEVEL=INFO

# JWT Secret Key
# JWT 토큰 생성/검증용 비밀키 (API 인증에 사용)
# 생성 방법: openssl rand -hex 32
SECRET_KEY=your_secret_key_for_jwt_here

# ============================================================================
# SERVICE PORTS
# ============================================================================

# Service Port Configuration
# 각 서비스가 사용할 포트 번호 설정
API_GATEWAY_PORT=8000       # 메인 API 게이트웨이
BACKTESTING_PORT=8001       # 백테스팅 서비스
ADMIN_UI_PORT=3000          # 관리자 웹 UI

# ============================================================================
# DATA COLLECTION SETTINGS
# ============================================================================

# Initial ETF List
# 시스템 시작 시 추적할 기본 ETF 목록
# SPY: S&P 500, QQQ: NASDAQ 100, TQQQ/SQQQ: 3x 레버리지 ETF
INITIAL_ETF_LIST=SPY,QQQ,DIA,IWM,VTI,TQQQ,SQQQ,TLT,GLD

# Data Collection Interval (minutes)
# 실시간 데이터 수집 주기 (분 단위)
# 낮을수록 더 자주 수집하지만 API 제한 주의
DATA_COLLECTION_INTERVAL=15

# Historical Data Years
# 초기 설정 시 수집할 과거 데이터 연수
# 백테스팅과 머신러닝 학습에 사용
HISTORICAL_DATA_YEARS=10

# ============================================================================
# MULTI-STRATEGY PORTFOLIO SETTINGS (신규)
# ============================================================================

# Active Portfolios Configuration
# 동시에 운영할 포트폴리오 이름 (콤마로 구분, 여러 개 가능)
# 가능한 값: Conservative Portfolio, Balanced Portfolio, Aggressive Portfolio, Multi-Timeframe Portfolio
# 예시: "Balanced Portfolio,Multi-Timeframe Portfolio" (2개 포트폴리오 동시 운영)
ACTIVE_PORTFOLIOS=Balanced Portfolio,Multi-Timeframe Portfolio

# Portfolio Capital Allocation
# 각 포트폴리오에 할당할 자본 비율 (콤마로 구분, 합계는 1.0 이하)
# 예시: "0.6,0.4" (첫 번째 포트폴리오 60%, 두 번째 40%)
PORTFOLIO_CAPITAL_ALLOCATION=0.5,0.5

# Enable Multi-Period Backtesting
# 백테스트 시 투자 기간에 따른 자동 반복 실행
# true: 단기 전략은 3년간 여러 번 반복 실행되어 총 수익 계산
# false: 모든 전략이 전체 기간 동안 한 번만 실행
ENABLE_MULTI_PERIOD_BACKTEST=true

# Compound Returns in Backtesting
# 백테스트 시 복리 수익 계산 여부
# true: 수익을 재투자하여 복리로 계산
# false: 단순 수익률 합산
COMPOUND_RETURNS=true

# Strategy Rebalancing Frequency (days)
# 전략 간 리밸런싱 주기 (일 단위)
# 낮을수록 자주 리밸런싱 (수수료 증가 주의)
STRATEGY_REBALANCE_FREQUENCY=30

# Maximum Concurrent Strategies
# 동시에 실행할 수 있는 최대 전략 수
# 너무 많으면 관리 복잡도 증가
MAX_CONCURRENT_STRATEGIES=15

# ============================================================================
# STRATEGY EXECUTION FREQUENCY (신규)
# ============================================================================

# Ultra Short Term Strategy Frequency (days)
# 초단기 전략 실행 주기 (1-5일 보유 전략)
ULTRA_SHORT_FREQUENCY=1

# Short Term Strategy Frequency (days)
# 단기 전략 실행 주기 (1-4주 보유 전략)
SHORT_FREQUENCY=3

# Medium Term Strategy Frequency (days)
# 중기 전략 실행 주기 (1-3개월 보유 전략)
MEDIUM_FREQUENCY=7

# Long Term Strategy Frequency (days)
# 장기 전략 실행 주기 (3-12개월 보유 전략)
LONG_FREQUENCY=14

# Ultra Long Term Strategy Frequency (days)
# 초장기 전략 실행 주기 (1년+ 보유 전략)
ULTRA_LONG_FREQUENCY=30

# ============================================================================
# RISK MANAGEMENT PER PORTFOLIO (신규)
# ============================================================================

# Enable Dynamic Risk Adjustment
# 시장 상황에 따른 동적 리스크 조정
# true: 변동성이 높을 때 자동으로 포지션 축소
ENABLE_DYNAMIC_RISK=true

# Portfolio Stop Loss
# 포트폴리오 전체 손실 한도 (비율)
# 0.15 = 15% 손실 시 모든 포지션 청산
PORTFOLIO_STOP_LOSS=0.15

# Daily Loss Limit
# 일일 손실 한도 (비율)
# 0.05 = 5% 손실 시 당일 추가 거래 중단
DAILY_LOSS_LIMIT=0.05

# Strategy Correlation Limit
# 전략 간 최대 허용 상관계수
# 0.7 = 70% 이상 상관관계 시 경고
MAX_STRATEGY_CORRELATION=0.7

# Cash Reserve Percentage
# 항상 유지할 현금 비율
# 0.05 = 5% 현금 보유 (긴급 상황 대비)
CASH_RESERVE=0.05

# ============================================================================
# NOTIFICATION SETTINGS (Optional)
# ============================================================================

# Email Notification Configuration (Optional)
# 효과: 중요 이벤트 이메일 알림 (주문 실행, 손실 한계, 시스템 오류)
SMTP_HOST=                  # 예: smtp.gmail.com
SMTP_PORT=587               # TLS 포트 (일반적으로 587)
SMTP_USER=                  # 이메일 계정
SMTP_PASSWORD=              # 이메일 비밀번호 또는 앱 비밀번호
ALERT_EMAIL=                # 알림을 받을 이메일 주소

# ============================================================================
# MONITORING (Optional)
# ============================================================================

# Prometheus Monitoring (Optional)
# 효과: 시스템 메트릭 수집 (CPU, 메모리, API 응답시간 등)
# true 설정 시 http://localhost:9090 에서 메트릭 확인 가능
PROMETHEUS_ENABLED=false

# Grafana Dashboard (Optional)
# 효과: 시각화 대시보드 제공 (성능 모니터링, 거래 분석)
# true 설정 시 http://localhost:3001 에서 대시보드 접근
GRAFANA_ENABLED=false

# ============================================================================
# KOREAN BROKER SETTINGS (Optional - 한국 증권사 연동)
# ============================================================================

# Korean Broker Configuration (Optional)
# 효과: 한국 증권사를 통한 미국 주식 거래 가능
# 지원 예정 증권사: 한국투자증권, 키움증권, NH투자증권 등

# Broker Type
# kiwoom: 키움증권
# korea_investment: 한국투자증권
# nh: NH투자증권
# mirae: 미래에셋증권
KR_BROKER_TYPE=

# Korean Broker API Credentials
# 각 증권사에서 발급받은 API 인증 정보
KR_BROKER_API_KEY=          # API 키 (앱키)
KR_BROKER_API_SECRET=       # API 시크릿 (앱시크릿키)
KR_BROKER_ACCOUNT=          # 계좌번호 (하이픈 포함)

# ============================================================================
# ADVANCED SETTINGS (Optional)
# ============================================================================

# Database Pool Settings (Optional)
# 데이터베이스 연결 풀 설정
# 효과: 동시 연결 수 제어로 성능 최적화
DB_POOL_SIZE=20             # 연결 풀 크기
DB_MAX_OVERFLOW=40          # 최대 오버플로우 연결 수

# Cache TTL Settings (Optional)
# 캐시 유효 시간 설정 (초 단위)
# 효과: 캐시 갱신 주기 제어
MARKET_DATA_CACHE_TTL=300   # 시장 데이터 캐시 (5분)
SIGNAL_CACHE_TTL=60         # 거래 신호 캐시 (1분)

# Rate Limiting (Optional)
# API 요청 제한 설정
# 효과: 외부 API 제한 준수 및 과도한 요청 방지
RATE_LIMIT_PER_MINUTE=60    # 분당 최대 요청 수
RATE_LIMIT_PER_HOUR=1000    # 시간당 최대 요청 수

# Machine Learning Settings (Optional)
# ML 모델 설정
# 효과: 머신러닝 전략 성능 조정
ML_RETRAIN_DAYS=30          # 모델 재학습 주기 (일)
ML_MIN_CONFIDENCE=0.6       # 최소 신뢰도 임계값
ML_MODEL_TYPE=ensemble      # 모델 타입 (ensemble, rf, gbm, nn)

# Backtesting Settings (Optional)
# 백테스팅 설정
# 효과: 백테스트 정확도와 속도 조절
BACKTEST_SLIPPAGE=0.001     # 슬리피지 비율 (0.1%)
BACKTEST_COMMISSION=0.001   # 수수료 비율 (0.1%)
BACKTEST_INITIAL_CASH=100000 # 초기 자본금 (달러)

# ============================================================================
# PERFORMANCE TRACKING (신규)
# ============================================================================

# Performance Alert Thresholds
# 성과 알림 임계값 설정

# Drawdown Alert Threshold
# 최대 손실 알림 임계값
# -0.1 = 10% 이상 손실 시 알림
DRAWDOWN_ALERT_THRESHOLD=-0.1

# Strategy Underperformance Threshold
# 전략 성과 부진 알림 임계값
# -0.15 = 벤치마크 대비 15% 이상 부진 시 알림
UNDERPERFORMANCE_THRESHOLD=-0.15

# Correlation Spike Alert
# 전략 간 상관관계 급증 알림
# 0.9 = 90% 이상 상관관계 시 알림
CORRELATION_ALERT=0.9

# ============================================================================
# SECURITY SETTINGS (Production Only)
# ============================================================================

# SSL/TLS Configuration (Production)
# 효과: HTTPS 통신으로 보안 강화
SSL_CERT_PATH=              # SSL 인증서 경로
SSL_KEY_PATH=               # SSL 개인키 경로

# API Rate Limiting per User (Production)
# 효과: 사용자별 API 사용량 제한
API_RATE_LIMIT_PER_USER=100 # 사용자당 분당 최대 요청

# Session Timeout (Production)
# 효과: 보안을 위한 자동 로그아웃
SESSION_TIMEOUT_MINUTES=30  # 세션 타임아웃 (분)